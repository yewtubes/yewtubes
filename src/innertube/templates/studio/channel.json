				"surveyTexts": {
					"richTexts": {
						"consentScreenTexts": {
							"headerTitle": {
								"isProminent": true,
								"title": {
									"runs": [
										{
											"text": "We need your help to make YouTube more inclusive. Take this 7-question survey. It will only take 5 minutes!"
										}
									]
								}
							},
							"sections": [
								{
									"items": [
										{
											"paragraph": {
												"runs": [
													{
														"text": "You’re invited to take a survey that will help us better understand the demographic and identity information of creator and artist communities on YouTube."
													}
												]
											}
										},
										{
											"paragraph": {
												"runs": [
													{
														"text": "If you agree to take the survey, we’ll use the information you provide to help us evaluate:"
													}
												]
											}
										},
										{
											"unorderedList": {
												"items": [
													{
														"runs": [
															{
																"text": "How our algorithms and systems treat content from various communities"
															}
														]
													},
													{
														"runs": [
															{
																"text": "How various communities are growing on YouTube"
															}
														]
													},
													{
														"runs": [
															{
																"text": "Potential patterns of abuse, including harassment and hate"
															}
														]
													},
													{
														"runs": [
															{
																"text": "Our current programs, campaigns, and offerings"
															}
														]
													}
												]
											}
										}
									]
								},
								{
									"header": {
										"runs": [
											{
												"text": "Tell us if you’re interested in special programs"
											}
										]
									},
									"items": [
										{
											"paragraph": {
												"runs": [
													{
														"text": "At the end of the survey, we ask whether we can use your answers when deciding whom to invite to special programs and celebrations. Special programs and celebrations may include having your channel or content highlighted and participating in programs, events, or campaigns such as user research, fundraising opportunities, or workshops."
													}
												]
											}
										}
									]
								},
								{
									"header": {
										"runs": [
											{
												"text": "How we’ll use your info"
											}
										]
									},
									"items": [
										{
											"paragraph": {
												"runs": [
													{
														"text": "We are optionally asking you to submit your demographic information. YouTube is a Google company. If you choose to provide your information, Google LLC will keep your information in accordance with the "
													},
													{
														"text": "Google Privacy Policy",
														"navigationEndpoint": {
															"commandMetadata": {
																"webCommandMetadata": {
																	"url": "https://policies.google.com/privacy?hl=en-US",
																	"webPageType": "WEB_PAGE_TYPE_UNKNOWN",
																	"rootVe": 83769
																}
															},
															"urlEndpoint": {
																"url": "https://policies.google.com/privacy?hl=en-US",
																"target": "TARGET_NEW_WINDOW"
															}
														}
													},
													{
														"text": "."
													}
												]
											}
										},
										{
											"paragraph": {
												"runs": [
													{
														"text": "We’ll use the information you share to help make YouTube a more accurate, consistent, safe, and inclusive platform. Your survey response information will not be made public without your additional consent, and it won’t be used for advertising purposes."
													}
												]
											}
										},
										{
											"paragraph": {
												"runs": [
													{
														"text": "You can delete your information any time."
													}
												]
											}
										},
										{
											"paragraph": {
												"runs": [
													{
														"text": "You consent to YouTube using the information that you provide in the survey for the purposes described above. "
													},
													{
														"text": "Learn more",
														"navigationEndpoint": {
															"commandMetadata": {
																"webCommandMetadata": {
																	"url": "https://support.google.com/youtube/answer/10272442?hl=en-US",
																	"webPageType": "WEB_PAGE_TYPE_UNKNOWN",
																	"rootVe": 83769
																}
															},
															"urlEndpoint": {
																"url": "https://support.google.com/youtube/answer/10272442?hl=en-US",
																"target": "TARGET_NEW_WINDOW"
															}
														}
													}
												]
											}
										}
									]
								}
							]
						},
						"channelLeadScreenTexts": {
							"headerTitle": {
								"title": {
									"runs": [
										{
											"text": "Main channel lead"
										}
